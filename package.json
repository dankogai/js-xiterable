{
  "name": "js-xiterable",
  "version": "0.3.0",
  "description": "Make ES6 Iterators Functional Again",
  "main": "xiterable.js",
  "module": "xiterable.js",
  "type": "module",
  "types": "xiterable.d.ts",
  "sideEffects": false,
  "files": [
    "xiterable.d.ts",
    "xiterable.js",
    "umd",
    "commonjs"
  ],
  "exports": {
    "import": "./xiterable.js",
    "require": "./commonjs/xiterable.js"
  },
  "scripts": {
    "build": "rollup -c && tsc -p . --declaration --emitDeclarationOnly",
    "clean": "node -e \"['xiterable.js','xiterable.d.ts','umd/xiterable.js','commonjs/xiterable.js'].forEach(f=>require('fs').rmSync(f,{force:true}))\"",
    "test": "npm run build && mocha",
    "version": "npm run build && node util/sync-version.cjs && git add xiterable.js xiterable.d.ts umd/xiterable.js commonjs/xiterable.js README.md"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.9.0",
    "chai": "^4.2.0",
    "mocha": "^10.0.0",
    "rollup": "^4.62.3",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dankogai/js-xiterable.git"
  },
  "keywords": [
    "iterable",
    "iterator",
    "generator",
    "es2015",
    "es6"
  ],
  "author": "Dan Kogai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dankogai/js-xiterable/issues"
  },
  "homepage": "https://github.com/dankogai/js-xiterable#readme"
}
